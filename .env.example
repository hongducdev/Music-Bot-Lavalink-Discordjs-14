# Bản mẫu. Sao chép thành .env rồi điền giá trị thật:
#   Copy-Item .env.example .env
#
# File .env là nơi chứa bí mật của BOT (đã bị git ignore).
# Lavalink chạy riêng, có .env riêng: ../lavalink-runtime/.env

# Bắt buộc — lấy tại https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Tuỳ chọn — deploy lệnh tức thì trong 1 server (bỏ trống = deploy toàn cục)
GUILD_ID=

# Tiền tố cho lệnh dạng text (mặc định: !)
PREFIX=!

# ===== RPC trên profile người yêu cầu (tuỳ chọn) =====
# Dùng CLIENT_ID ở trên; bật Social SDK + OAuth2 Public Client cho application.
# Đăng ký cùng Redirect URL trong Developer Portal.
# Nhiều người dùng: HTTPS qua reverse proxy tới 127.0.0.1:8787.
# Tự thử trên máy chạy bot: http://127.0.0.1:8787/callback
# Bỏ trống để tắt RPC.
RPC_REDIRECT_URI=
RPC_HOST=127.0.0.1
RPC_PORT=8787

# ===== Lavalink (bot chỉ cần biết địa chỉ + mật khẩu) =====
# Lavalink chạy riêng (xem ../lavalink-runtime hoặc máy khác); JVM, yt-dlp, OAuth
# YouTube và Spotify thuộc .env của tiến trình đó, không nằm ở đây.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_SECURE=false
# Đặt mật khẩu ngẫu nhiên, ĐỪNG dùng "youshallnotpass":
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Phải TRÙNG với LAVALINK_PASSWORD trong .env của Lavalink, nếu không bot nhận 401.
LAVALINK_PASSWORD=change_me_to_a_random_password
