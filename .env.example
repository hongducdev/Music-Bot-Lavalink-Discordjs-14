# Bản mẫu. Sao chép thành .env rồi điền giá trị thật:
#   Copy-Item .env.example .env
#
# File .env là NƠI DUY NHẤT chứa bí mật của dự án (đã bị git ignore).
# lavalink/application.yml đọc lại các biến dưới đây qua lavalink/start.ps1

# Bắt buộc — lấy tại https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Tuỳ chọn — deploy lệnh tức thì trong 1 server (bỏ trống = deploy toàn cục)
GUILD_ID=

# Tiền tố cho lệnh dạng text (mặc định: !)
PREFIX=!

# ===== Lavalink =====
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_SECURE=false
# Đặt mật khẩu ngẫu nhiên, ĐỪNG dùng "youshallnotpass":
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
LAVALINK_PASSWORD=change_me_to_a_random_password

# ===== YouTube OAuth (tuỳ chọn) =====
# Dùng TÀI KHOẢN PHỤ, không dùng tài khoản chính.
# Lấy bằng cách: bật oauth trong application.yml, chạy Lavalink,
# làm theo hướng dẫn trên terminal, Lavalink sẽ in refresh token ra.
YT_OAUTH_REFRESH_TOKEN=

# ===== Spotify (tuỳ chọn) =====
# Tạo app miễn phí tại https://developer.spotify.com/dashboard
# Sau khi điền, đổi plugins.lavasrc.sources.spotify thành true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
