# Bản mẫu. Sao chép thành .env rồi điền giá trị thật:
#   Copy-Item .env.example .env

# Bắt buộc — lấy tại https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Tuỳ chọn — deploy lệnh tức thì trong 1 server (bỏ trống = deploy toàn cục)
GUILD_ID=

# Tiền tố cho lệnh dạng text (mặc định: !)
PREFIX=!

# Phải khớp mục lavalink.server.password trong lavalink/application.yml
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
